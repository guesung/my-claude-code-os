+
+<style is:global>
+  section {
+    background: #fff;
+  }
+</style>
diff --git a/src/hooks/usePromoBanner.ts b/src/hooks/usePromoBanner.ts
new file mode 100644
--- /dev/null
+++ b/src/hooks/usePromoBanner.ts
@@ -0,0 +1,9 @@
+import { useCallback, useState } from "react";
+
+export const usePromoBanner = () => {
+  const [isOpen, setIsOpen] = useState(false);
+  const handleClick = useCallback(() => {
+    setIsOpen(true);
+  }, []);
+  return { isOpen, handleClick };
+};
